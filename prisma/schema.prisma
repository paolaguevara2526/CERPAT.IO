// Esquema de base de datos — Planeador CERPAT
// Arquitectura multi-tenant (SaaS multi-firma): cada Organizacion (firma contable)
// es un tenant aislado; todas las entidades del dominio llevan organizacionId.
// El acceso "root" de plataforma se modela con Usuario.esRootPlataforma (y
// organizacionId nulo). Ver docs/arquitectura.md (ADR-0001) y modelo-de-datos.md.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- ENUMS (reflejan exactamente las reglas de negocio ya validadas) ----------

enum EstadoTarea {
  por_iniciar
  en_curso
  en_revision
  terminado
  auditado
  no_realizado
}

enum Prioridad {
  alta
  media
  baja
}

enum EstadoAuditoria {
  pendiente
  aprobada
  rechazada
}

enum EstadoSubtarea {
  pendiente
  realizada
  no_aplica
  no_realizada
}

// Revisoría Fiscal · Portal de Hallazgos
enum RiesgoNivel {
  alto
  medio
  bajo
}

enum EstadoHallazgo {
  pendiente
  en_gestion
  resuelto
}

enum EstadoTareaPago {
  por_iniciar
  en_curso
  terminado
}

enum EstadoPago {
  pendiente
  presentado_sin_pago
  presentado_pagado
  presentado_cero
  no_presentado
  no_obligado
}

// ---------- TENANT: ORGANIZACION (firma contable) ----------
// Raíz del aislamiento multi-tenant. Todo el dominio cuelga de aquí.
// Un usuario root de plataforma (Usuario.esRootPlataforma) vive por fuera de
// cualquier organización y puede administrarlas todas.

model Organizacion {
  id        String   @id @default(uuid())
  nombre    String
  slug      String   @unique // identificador/subdominio de la firma (p. ej. "cerpat")
  nit       String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios     Usuario[]
  roles        Rol[]
  asesores     Asesor[]
  empresas     Empresa[]
  tareas       Tarea[]
  pagos        Pago[]
  vencimientos Vencimiento[]

  // Catálogos (por organización)
  tiposEmpresa      TipoEmpresa[]
  sectores          Sector[]
  regimenes         RegimenTributario[]
  periodicidadesIva PeriodicidadIva[]
  tiposServicio     TipoServicio[]
  municipios        Municipio[]
  tiposTarea        TipoTarea[]
  tiposObligacion   TipoObligacion[]
  periodicidades    Periodicidad[]
  etiquetas         Etiqueta[]

  // Configuración de fila única (por organización)
  parametros ParametrosLiquidacion?
  apariencia Apariencia?

  // Plan de trabajo
  areas            Area[]
  actividadesPlan  ActividadPlan[]
  planesCliente    PlanClienteActividad[]
  asignacionesArea AsignacionClienteArea[]

  // Revisoría Fiscal
  grupos    GrupoEmpresarial[]
  hallazgos Hallazgo[]
  configuracionesTributarias ConfiguracionTributaria[]
  municipiosIca              EmpresaMunicipioIca[]
  vencimientosEmpresa        VencimientoEmpresa[]

  @@map("organizaciones")
}

// ---------- USUARIOS Y ROLES ----------

model Usuario {
  id              String   @id @default(uuid())
  organizacionId  String? // null = usuario root de plataforma (fuera de toda firma)
  nombre          String
  email           String
  passwordHash    String
  cargo           String? // cargo en la firma (texto libre: "Asesor Junior", "Lider Tesoreria"...)
  area            String? // área organizativa del empleado (Impuestos, Informes, Nómina...)
  activo          Boolean  @default(true)
  esRootPlataforma Boolean @default(false)
  debeCambiarPassword Boolean @default(false) // fuerza cambio de clave en el próximo ingreso
  ultimoLogin      DateTime?
  // Cliente externo (Revisoría Fiscal): ligado a su empresa o a un grupo empresarial.
  empresaClienteId String?
  grupoClienteId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organizacion  Organizacion?   @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  roles         UsuarioRol[]
  tareasCreadas Tarea[]         @relation("TareasCreadas")
  hallazgosCreados Hallazgo[]   @relation("HallazgosCreados")
  empresaClienteRel Empresa?         @relation("UsuarioEmpresaCliente", fields: [empresaClienteId], references: [id])
  grupoClienteRel   GrupoEmpresarial? @relation("UsuarioGrupoCliente", fields: [grupoClienteId], references: [id])
  asignaciones  TareaAsignado[]
  asesor        Asesor?
  tareasComoAsesor   Tarea[]                 @relation("TareaAsesor")
  tareasComoAuxiliar Tarea[]                 @relation("TareaAuxiliar")
  areasComoAsesor    AsignacionClienteArea[] @relation("AsesorArea")
  areasComoAuxiliar  AsignacionClienteArea[] @relation("AuxiliarArea")

  // Email único por organización (dos firmas distintas pueden repetir email).
  @@unique([organizacionId, email])
  @@index([organizacionId])
  @@map("usuarios")
}

model Rol {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String // Administrador, Asesor, Auditor, Auxiliar
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuarios       UsuarioRol[]

  @@unique([organizacionId, nombre])
  @@index([organizacionId])
  @@map("roles")
}

model UsuarioRol {
  usuarioId String
  rolId     String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_roles")
}

// Un asesor puede o no tener una cuenta de usuario asociada (usuarioId nullable)
model Asesor {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  usuarioId      String?      @unique
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id])

  @@index([organizacionId])
  @@map("asesores")
}

// ---------- EMPRESAS (CLIENTES) ----------

model Empresa {
  id                String   @id @default(uuid())
  organizacionId    String
  nombre            String
  nit               String?
  tipoId            String?
  sectorId          String?
  regimenId         String?
  periodicidadIvaId String?
  municipioId       String?
  grupoId           String? // grupo empresarial (Revisoría Fiscal)
  // Datos operativos y de contacto (base de clientes CERPAT)
  servicio            String? // Asesoría Contable | Outsourcing | Revisoría Contable
  asesorNombre        String? // asesor responsable (texto; puede quedar vinculado a Asesor luego)
  activo              Boolean @default(true) // false = cliente inactivo (no se lista)
  emailRepresentante  String?
  emailAdministracion String?
  emailContabilidad   String?
  emailTalentoHumano  String?
  emailTesoreria      String?
  createdAt         DateTime @default(now())

  organizacion    Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tipo            TipoEmpresa?       @relation(fields: [tipoId], references: [id])
  sector          Sector?            @relation(fields: [sectorId], references: [id])
  regimen         RegimenTributario? @relation(fields: [regimenId], references: [id])
  periodicidadIva PeriodicidadIva?   @relation(fields: [periodicidadIvaId], references: [id])
  municipio       Municipio?         @relation(fields: [municipioId], references: [id])
  grupo           GrupoEmpresarial?  @relation(fields: [grupoId], references: [id])

  tareas Tarea[]
  pagos  Pago[]
  hallazgos        Hallazgo[]
  usuariosCliente  Usuario[]              @relation("UsuarioEmpresaCliente")
  planActividades  PlanClienteActividad[]
  asignacionesArea AsignacionClienteArea[]
  configuracionTributaria ConfiguracionTributaria?
  municipiosIca           EmpresaMunicipioIca[]
  vencimientosEmpresa     VencimientoEmpresa[]

  @@index([organizacionId])
  @@map("empresas")
}

// ---------- REVISORÍA FISCAL · Portal de Hallazgos ----------

// Grupo empresarial: agrupa varias empresas cliente para la vista consolidada
// (asamblea/junta). Un usuario cliente puede estar ligado a un grupo (ve todas
// sus empresas) o a una sola empresa.
model GrupoEmpresarial {
  id             String  @id @default(uuid())
  organizacionId String
  nombre         String

  organizacion    Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresas        Empresa[]
  usuariosCliente Usuario[]    @relation("UsuarioGrupoCliente")

  @@unique([organizacionId, nombre])
  @@index([organizacionId])
  @@map("grupos_empresariales")
}

// Hallazgo de revisoría fiscal + su plan de acción. El revisor (rol Auditor) lo
// alimenta; el cliente lo ve en solo lectura. "Vencido" se deriva (plazo < hoy
// y estado != resuelto), no se almacena.
model Hallazgo {
  id             String         @id @default(uuid())
  organizacionId String
  empresaId      String
  area           String? // área/proceso auditado
  titulo         String // hallazgo (título corto)
  descripcion    String? // descripción de la situación
  normatividad   String?
  riesgo         RiesgoNivel    @default(medio)
  riesgoDescripcion String?     // narrativa del riesgo/impacto (texto libre de la matriz)
  prioridad      Prioridad      @default(media) // prioridad sugerida
  responsable    String?
  planAccion     String? // acción o plan de remediación
  plazo          DateTime?
  estado         EstadoHallazgo @default(pendiente)
  observaciones  String? // observaciones de seguimiento
  creadoPorId    String? // revisor que lo registró
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  creadoPor    Usuario?     @relation("HallazgosCreados", fields: [creadoPorId], references: [id])

  @@index([organizacionId])
  @@index([empresaId])
  @@index([estado])
  @@map("hallazgos")
}

// ---------- CATÁLOGOS (Administración → Catálogos) ----------

model TipoEmpresa {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresas       Empresa[]

  @@index([organizacionId])
  @@map("cat_tipos_empresa")
}

model Sector {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresas       Empresa[]

  @@index([organizacionId])
  @@map("cat_sectores")
}

model RegimenTributario {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresas       Empresa[]

  @@index([organizacionId])
  @@map("cat_regimenes_tributarios")
}

model PeriodicidadIva {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresas       Empresa[]

  @@index([organizacionId])
  @@map("cat_periodicidades_iva")
}

model TipoServicio {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
  @@map("cat_tipos_servicio")
}

model Municipio {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  departamento   String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresas       Empresa[]
  icaEmpresas    EmpresaMunicipioIca[]
  vencimientos   VencimientoEmpresa[]

  @@index([organizacionId])
  @@map("cat_municipios")
}

// ---------- CATÁLOGOS DE TAREAS (Administración → Cat. Tareas) ----------

model TipoTarea {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tareas         Tarea[]

  @@index([organizacionId])
  @@map("cat_tipos_tarea")
}

model TipoObligacion {
  id             String        @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int           @default(0)
  organizacion   Organizacion  @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tareas         Tarea[]
  pagos          Pago[]
  vencimientos   Vencimiento[]

  @@index([organizacionId])
  @@map("cat_tipos_obligacion")
}

model Periodicidad {
  id             String       @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int          @default(0)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tareas         Tarea[]

  @@index([organizacionId])
  @@map("cat_periodicidades")
}

model Etiqueta {
  id             String          @id @default(uuid())
  organizacionId String
  nombre         String
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  tareas         TareaEtiqueta[]

  @@unique([organizacionId, nombre])
  @@index([organizacionId])
  @@map("cat_etiquetas")
}

// ---------- TAREAS ----------

model Tarea {
  id                      String          @id @default(uuid())
  organizacionId          String
  titulo                  String
  empresaId               String
  estado                  EstadoTarea     @default(por_iniciar)
  prioridad               Prioridad       @default(media)
  fechaInicio             DateTime
  fechaVencimiento        DateTime
  tipoTareaId             String?
  tipoObligacionId        String?
  periodicidadId          String?
  auditoria               EstadoAuditoria @default(pendiente)
  requiereRevisionTecnica Boolean         @default(false)
  generaPago              Boolean         @default(false)
  valorPago               Decimal?        @db.Decimal(14, 2) // valor de la obligación, digitado por el ejecutor
  estadoPago              EstadoPago      @default(pendiente)
  generaIneficacia        Boolean         @default(false)
  requiereSoporte         Boolean         @default(false)
  soporteLink             String?
  interno                 Boolean         @default(false) // true = no se muestra en calendario/impresión para cliente
  observaciones           String?
  creadoPorId             String?
  // Vínculo al Plan de Trabajo (las tareas generadas por el plan lo llevan)
  actividadPlanId   String?
  areaId            String?
  periodo           String? // "YYYY-MM" del período del plan
  asesorId          String? // responsable (heredado de la asignación cliente×área)
  auxiliarId        String? // ejecutor
  comprobanteDesde  String? // registro en software: comprobante inicial
  comprobanteHasta  String? // comprobante final
  cantidadRegistros Int? //    # de registros realizados
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  tipoTarea      TipoTarea?      @relation(fields: [tipoTareaId], references: [id])
  tipoObligacion TipoObligacion? @relation(fields: [tipoObligacionId], references: [id])
  periodicidad   Periodicidad?   @relation(fields: [periodicidadId], references: [id])
  creadoPor      Usuario?        @relation("TareasCreadas", fields: [creadoPorId], references: [id])
  actividadPlan  ActividadPlan?  @relation(fields: [actividadPlanId], references: [id])
  area           Area?           @relation(fields: [areaId], references: [id])
  asesor         Usuario?        @relation("TareaAsesor", fields: [asesorId], references: [id])
  auxiliar       Usuario?        @relation("TareaAuxiliar", fields: [auxiliarId], references: [id])

  asignados TareaAsignado[]
  etiquetas TareaEtiqueta[]
  subtareas Subtarea[]

  @@index([organizacionId])
  @@index([fechaVencimiento])
  @@index([estado])
  @@index([empresaId])
  @@index([actividadPlanId])
  @@index([areaId])
  @@map("tareas")
}

model TareaAsignado {
  tareaId   String
  usuarioId String
  tarea     Tarea   @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@id([tareaId, usuarioId])
  @@map("tarea_asignados")
}

model TareaEtiqueta {
  tareaId    String
  etiquetaId String
  tarea      Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id])

  @@id([tareaId, etiquetaId])
  @@map("tarea_etiquetas")
}

// Regla de negocio: una tarea no puede pasar a "terminado"/"auditado"
// si alguna subtarea sigue en estado "pendiente". Validar en el backend.
model Subtarea {
  id      String         @id @default(uuid())
  tareaId String
  texto   String
  estado  EstadoSubtarea @default(pendiente)
  orden   Int            @default(0)
  tarea   Tarea          @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@map("subtareas")
}

// ---------- PAGOS (seguimiento de obligaciones) ----------

model Pago {
  id               String          @id @default(uuid())
  organizacionId   String
  empresaId        String
  obligacionId     String?
  obligacionTexto  String? // usar si la obligación no está en el catálogo
  periodicidad     String?
  fechaVencimiento DateTime
  valor            Decimal         @default(0) @db.Decimal(14, 2)
  estadoTarea      EstadoTareaPago @default(por_iniciar)
  estadoPago       EstadoPago      @default(pendiente)
  createdAt        DateTime        @default(now())

  organizacion Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa      Empresa         @relation(fields: [empresaId], references: [id])
  obligacion   TipoObligacion? @relation(fields: [obligacionId], references: [id])

  @@index([organizacionId])
  @@index([fechaVencimiento])
  @@index([empresaId])
  @@map("pagos")
}

// ---------- VENCIMIENTOS (calendario tributario general) ----------

model Vencimiento {
  id               String   @id @default(uuid())
  organizacionId   String
  obligacionId     String?
  municipio        String?
  periodo          String?
  fechaVencimiento DateTime
  nitRango         String?

  organizacion Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  obligacion   TipoObligacion? @relation(fields: [obligacionId], references: [id])

  @@index([organizacionId])
  @@map("vencimientos")
}

// ---------- PARÁMETROS DEL LIQUIDADOR DE INTERESES (fila única por organización) ----------

model ParametrosLiquidacion {
  id                        String  @id @default(uuid())
  organizacionId            String  @unique
  tasaMoraMensual           Decimal @default(0.2679) @db.Decimal(6, 4)
  valorUvt                  Decimal @default(52374) @db.Decimal(12, 2)
  smmlv                     Decimal @default(1423500) @db.Decimal(12, 2)
  sancionMinimaUvt          Decimal @default(10) @db.Decimal(6, 2)
  pctSancionExtemporaneidad Decimal @default(0.05) @db.Decimal(5, 4)

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@map("parametros_liquidacion")
}

// ---------- APARIENCIA (fila única de configuración de marca por organización) ----------

model Apariencia {
  id             String @id @default(uuid())
  organizacionId String @unique
  nombreApp      String @default("Planeador")
  subtitulo      String @default("Sistema de Gestión y Planificación")
  colorPrimario  String @default("#34C98B")

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)

  @@map("apariencia")
}

// ---------- PLAN DE TRABAJO CONTABLE ----------
// Unifica con el planeador: ActividadPlan (plantilla) genera Tarea (entidad ya
// existente que aparece en Calendario/Tablero/Lista/Mi Día). El rol "Coordinador"
// es una fila de Rol (no requiere esquema). Ver docs/estado-y-plan.md.

// Área organizacional de la firma (Impuestos, Informes, Cumplimiento, Nómina, Tesorería)
model Area {
  id             String @id @default(uuid())
  organizacionId String
  nombre         String
  orden          Int    @default(0)

  organizacion Organizacion            @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  actividades  ActividadPlan[]
  asignaciones AsignacionClienteArea[]
  tareas       Tarea[]

  @@unique([organizacionId, nombre])
  @@index([organizacionId])
  @@map("areas")
}

// Catálogo base de actividades del plan (plantilla maestra)
model ActividadPlan {
  id                 String  @id @default(uuid())
  organizacionId     String
  areaId             String?
  grupo              String? // grupo contable (Estados Financieros, Impuestos DIAN, ...)
  codigo             String
  nombre             String
  descripcion        String?
  documentoFormato   String?
  periodicidad       String? // periodicidad sugerida (texto del catálogo)
  esRegistroSoftware Boolean @default(false)
  requiereAuditoria  Boolean @default(false)
  generaPago         Boolean @default(false) // la actividad implica un pago (obligación DIAN/entidades)
  orden              Int     @default(0)
  activo             Boolean @default(true)

  organizacion Organizacion           @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  area         Area?                  @relation(fields: [areaId], references: [id])
  subtareas    SubtareaPlantilla[]
  planes       PlanClienteActividad[]
  tareas       Tarea[]

  @@unique([organizacionId, codigo])
  @@index([organizacionId])
  @@map("actividades_plan")
}

// Checklist plantilla de una actividad → se copia a Subtarea al generar la tarea
model SubtareaPlantilla {
  id              String @id @default(uuid())
  actividadPlanId String
  texto           String
  orden           Int    @default(0)

  actividad ActividadPlan @relation(fields: [actividadPlanId], references: [id], onDelete: Cascade)

  @@map("subtareas_plantilla")
}

// Qué actividades del catálogo aplican a cada cliente (agregar/quitar por área)
model PlanClienteActividad {
  id              String  @id @default(uuid())
  organizacionId  String
  empresaId       String
  actividadPlanId String
  activa          Boolean @default(true)
  periodicidad    String? // periodicidad propia del cliente (override del catálogo)

  organizacion Organizacion  @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  actividad    ActividadPlan @relation(fields: [actividadPlanId], references: [id], onDelete: Cascade)

  @@unique([empresaId, actividadPlanId])
  @@index([organizacionId])
  @@map("plan_cliente_actividad")
}

// Por empresa × área: asesor (responsable), auxiliar (ejecutor) y talla (tamaño)
model AsignacionClienteArea {
  id             String  @id @default(uuid())
  organizacionId String
  empresaId      String
  areaId         String
  asesorId       String?
  auxiliarId     String?
  talla          String? // S / M / L / XL — tamaño de la empresa por área

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  area         Area         @relation(fields: [areaId], references: [id], onDelete: Cascade)
  asesor       Usuario?     @relation("AsesorArea", fields: [asesorId], references: [id])
  auxiliar     Usuario?     @relation("AuxiliarArea", fields: [auxiliarId], references: [id])

  @@unique([empresaId, areaId])
  @@index([organizacionId])
  @@map("asignacion_cliente_area")
}

// ---------- Parametrización de vencimientos tributarios ----------

// Configuración tributaria nacional de cada empresa (1:1). Alimenta la
// generación de vencimientos de Retención, IVA, Consumo, Anticipo RST y Renta.
model ConfiguracionTributaria {
  id             String @id @default(uuid())
  organizacionId String
  empresaId      String @unique
  ivaPeriodicidad         String? // bimestral | cuatrimestral | anual_rst | no_responsable
  retencionFuente         Boolean @default(false) // agente retenedor (declara mensual)
  fopat                   Boolean @default(false) // agente de retención FOPAT (transporte; mensual)
  consumoPeriodicidad     String? // bimestral | anual_rst | null (no responsable)
  rentaTipo               String? // persona_juridica | persona_natural | gran_contribuyente | rst_consolidada | na
  anticipoRstPeriodicidad String? // bimestral | null (no aplica)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([organizacionId])
  @@map("configuracion_tributaria")
}

// Responsabilidad de ICA por empresa × municipio (una empresa declara ICA en
// muchos municipios). Incluye RETEICA y AUTOICA con su periodicidad.
model EmpresaMunicipioIca {
  id             String @id @default(uuid())
  organizacionId String
  empresaId      String
  municipioId    String
  icaPeriodicidad     String? // anual | bimestral | mensual
  reteica             Boolean @default(false)
  reteicaPeriodicidad String?
  autoica             Boolean @default(false)
  autoicaPeriodicidad String?
  // Fecha de inscripción del cliente en el ICA de ese municipio. Si está, al
  // generar vencimientos solo se crean los de fecha en/después de esta (no
  // afecta lo ya cargado de periodos anteriores).
  fechaInscripcion    DateTime?

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  municipio    Municipio    @relation(fields: [municipioId], references: [id])

  @@unique([empresaId, municipioId])
  @@index([organizacionId])
  @@map("empresa_municipio_ica")
}

// Vencimiento generado para una empresa (salida del generador: config × calendario
// × último dígito del NIT). Editable solo por Administrador/root por ahora.
model VencimientoEmpresa {
  id             String     @id @default(uuid())
  organizacionId String
  empresaId      String
  anio           Int
  obligacion     String // Retención en la fuente, IVA, Impuesto al consumo, Anticipo RST, Renta PJ/GC/PN, RST consolidada Renta, IVA consolidado RST
  periodicidad   String?
  periodo        String? // 2026-01, ene-feb, 1a cuota, anual...
  municipioId    String? // ICA (a futuro)
  fechaVencimiento DateTime
  estado         EstadoPago @default(pendiente)
  generado       Boolean    @default(true) // creado por el generador (vs. agregado a mano)
  notas          String?
  soporteLink    String? // link (Drive/OneDrive) donde va quedando el trabajo de la obligación
  valorPago      Decimal?   @db.Decimal(14, 2) // valor a pagar de la obligación (cuando da valor)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organizacion Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Cascade)
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  municipio    Municipio?   @relation(fields: [municipioId], references: [id])

  @@index([organizacionId])
  @@index([empresaId])
  @@index([anio])
  @@index([fechaVencimiento])
  @@map("vencimientos_empresa")
}
